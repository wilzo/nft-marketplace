# Ativa a camada MSW (REST + Socket.IO simulados). Padrão: true (inclusive no build de demonstração).
VITE_ENABLE_MOCKS=true
# Prefixo das rotas REST interceptadas pelo MSW.
VITE_API_BASE_URL=/api
# Endereço do Socket.IO interceptado pelo @mswjs/socket.io-binding.
VITE_SOCKET_URL=ws://localhost/realtime
